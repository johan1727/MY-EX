{
    "version": 2,
    "buildCommand": "npx expo export --platform web",
    "outputDirectory": "dist",
    "functions": {
        "api/stripe/create-checkout.js": {
            "memory": 1024,
            "maxDuration": 10
        }
    },
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}